#!/usr/bin/env python3
"""Require complete Swift test evidence and inspect diagnostics hidden by xcodebuild's exit code."""

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import parse_qs, unquote, urlparse

sys.dont_write_bytecode = True

RUNTIME_DIAGNOSTIC = re.compile(
    r"Unbalanced calls to begin/end appearance transitions|"
    r"Main Thread Checker:|Thread Sanitizer:|"
    r"Publishing changes from|Modifying state during view update|"
    r"Accessing State(?:Object)?'s (?:object|value) (?:without|outside of) being installed|"
    r"Accessing Environment<.*outside of being installed|"
    r"Potential Structural Swift Concurrency Issue|BUG IN CLIENT OF LIBDISPATCH"
)


BUILD_WARNING = re.compile(r"(?:^|\s)warning:", re.IGNORECASE)


SENTRY_HINT_DEPRECATION = (
    "setter for 'beforeSendWithHint' is deprecated: In the next major version, "
    "the hint parameter will be added to `beforeSend` directly and this callback "
    "will be removed. Use this only to adopt hints ahead of the next major version."
)


def sentry_hint_location():
    source = Path(__file__).resolve().parents[1] / "PodHaven/AppLauncher.swift"
    if not source.is_file():
        return None
    lines = [number for number, line in enumerate(source.read_text().splitlines(), 1)
             if line.strip() == "options.beforeSendWithHint = { event, hint in"]
    return (source, lines[0]) if len(lines) == 1 else None


def approved_sentry_warning(warning):
    location = sentry_hint_location()
    if not location or warning.get("issueType") != "DeprecatedDeclaration":
        return False
    if warning.get("message", "").lower() != SENTRY_HINT_DEPRECATION.lower():
        return False
    url = urlparse(warning.get("sourceURL", ""))
    return (url.scheme == "file" and Path(unquote(url.path)) == location[0]
            and parse_qs(url.fragment).get("StartingLineNumber") == [str(location[1] - 1)])


def approved_sentry_log_warning(line):
    location = sentry_hint_location()
    if not location:
        return False
    return re.fullmatch(
        re.escape(str(location[0])) + ":" + str(location[1]) + r":\d+: warning: "
        + re.escape(SENTRY_HINT_DEPRECATION) + r"(?: \[#DeprecatedDeclaration\])?", line) is not None


def failures(summary, build, runtime_logs, build_log):
    problems = []
    if summary.get("result") != "Passed" or summary.get("failedTests", 0):
        problems.append("Test result did not pass")
    if summary.get("passedTests", 0) <= 0:
        problems.append("No tests passed")
    if summary.get("skippedTests", 0):
        problems.append(f"Skipped tests: {summary['skippedTests']}")
    for key in ("errorCount", "analyzerWarningCount"):
        if key not in build or build[key] != 0:
            problems.append(f"Build {key}: {build.get(key, 'missing')}")
    warnings = build.get("warnings", [])
    accepted = sum(approved_sentry_warning(warning) for warning in warnings)
    if build.get("warningCount") != accepted or len(warnings) != accepted:
        problems.append(f"Unapproved build warnings: {build.get('warningCount', 'missing')}; approved: {accepted}")
    if not build_log.strip():
        problems.append("Missing or empty raw build log")
    for number, line in enumerate(build_log.splitlines(), 1):
        if BUILD_WARNING.search(line) and not approved_sentry_log_warning(line):
            problems.append(f"Build log:{number}: {line}")
    if not runtime_logs or not any(text.strip() for text in runtime_logs.values()):
        problems.append("Missing exported test stdout/stderr")
    for path, contents in runtime_logs.items():
        for number, line in enumerate(contents.splitlines(), 1):
            if RUNTIME_DIAGNOSTIC.search(line):
                problems.append(f"{path}:{number}: {line}")
    return problems


def check_arguments(tree):
    expected = {
        "WorkerTaskPriorityTests/backgroundExecution(process:)": {
            ".silenceAnalysis", ".transcription", ".embeddingComputation",
            ".publisherTranscripts", ".cachePurge", ".feedRefresh",
        },
        "BackgroundTaskSchedulerTests/executionPriority(priority:override:)": {
            f"TaskPriority.{priority}, .{override}"
            for priority in ("background", "low")
            for override in ("unchanged", "high", "inherit")
        },
        "SilenceSchedulerTests/foregroundTaskPriority(priority:)": {
            "TaskPriority.background", "TaskPriority.high",
        },
    }
    found = {}

    def visit(node):
        if isinstance(node, dict):
            identifier = node.get("nodeIdentifier")
            if identifier in expected:
                found[identifier] = {
                    child["name"] for child in node.get("children", [])
                    if child.get("nodeType") == "Arguments" and child.get("result") == "Passed"
                }
            for value in node.values():
                visit(value)
        elif isinstance(node, list):
            for value in node:
                visit(value)

    visit(tree)
    return [
        f"Incomplete argument coverage for {identifier}: missing {sorted(arguments - found.get(identifier, set()))}"
        for identifier, arguments in expected.items()
        if not arguments <= found.get(identifier, set())
    ]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("bundle", type=Path)
    parser.add_argument("--build-log", type=Path, required=True)
    parser.add_argument("--full", action="store_true", help="Require complete worker and silence priority coverage")
    args = parser.parse_args()
    if not args.bundle.is_dir():
        print(f"error: Missing Swift test result bundle: {args.bundle}. "
              f"Check {args.build_log} for the launch or build failure before retrying.", file=sys.stderr)
        return 1
    output = args.bundle.with_suffix(".validation")
    output.mkdir(parents=True, exist_ok=True)
    data = {}
    for name, command in {
        "summary": ["get", "test-results", "summary"],
        "build": ["get", "build-results"],
        "tests": ["get", "test-results", "tests"],
    }.items():
        raw = subprocess.check_output(
            ["xcrun", "xcresulttool", *command, "--path", str(args.bundle), "--compact"], text=True
        )
        (output / f"{name}.json").write_text(raw)
        data[name] = json.loads(raw)
    diagnostics = output / "diagnostics"
    subprocess.run(
        ["xcrun", "xcresulttool", "export", "diagnostics", "--path", str(args.bundle),
         "--output-path", str(diagnostics)], check=True
    )
    logs = {str(path): path.read_text(errors="replace")
            for path in diagnostics.rglob("StandardOutputAndStandardError.txt")}
    problems = failures(data["summary"], data["build"], logs, args.build_log.read_text(errors="replace"))
    if args.full:
        problems.extend(check_arguments(data["tests"]))
    (output / "diagnostic-failures.json").write_text(json.dumps(problems, indent=2) + "\n")
    for problem in problems:
        print(problem, file=sys.stderr)
    if problems:
        return 1
    accepted = sum(approved_sentry_warning(warning) for warning in data["build"].get("warnings", []))
    print(f"Swift validation passed: {data['summary']['passedTests']} tests; "
          f"{accepted} approved Sentry hint deprecation warnings; zero other build/runtime diagnostics")
    return 0


if __name__ == "__main__":
    sys.exit(main())
