#!/usr/bin/env bash
# Launch a Cursor cloud agent to audit memory/ and poll until completion.
# Requires: curl, jq, CURSOR_API_KEY
set -euo pipefail

REPO_URL="${REPO_URL:-https://github.com/jubishop/podhaven}"
GITHUB_REPO="${GITHUB_REPOSITORY:-${REPO_URL#https://github.com/}}"
STARTING_REF="${STARTING_REF:-main}"
MODEL_ID="${MODEL_ID:-composer-2.5}"
POLL_SECONDS="${POLL_SECONDS:-30}"
MAX_WAIT_SECONDS="${MAX_WAIT_SECONDS:-3600}"
ARTIFACT_RETRIES="${ARTIFACT_RETRIES:-6}"
ARTIFACT_RETRY_SECONDS="${ARTIFACT_RETRY_SECONDS:-10}"
API_BASE="${API_BASE:-https://api.cursor.com/v1}"
REPORT_REL_PATH="artifacts/memory-audit-report.md"
REPORT_START_MARKER='<!-- MEMORY_AUDIT_REPORT_START -->'
REPORT_END_MARKER='<!-- MEMORY_AUDIT_REPORT_END -->'

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PROMPT_FILE="$ROOT/bin/memory-audit-prompt.md"
ARTIFACT_DIR="${RUNNER_TEMP:-/tmp}/memory-audit"
REPORT_PATH="$ARTIFACT_DIR/memory-audit-report.md"
META_PATH="$ARTIFACT_DIR/run-meta.json"

extract_report_from_result() {
  local text="$1"
  local extracted=""

  if [[ "$text" == *"$REPORT_START_MARKER"* ]]; then
    extracted="$(awk -v start="$REPORT_START_MARKER" -v end="$REPORT_END_MARKER" '
      $0 == start { capture=1; next }
      $0 == end { capture=0 }
      capture { print }
    ' <<<"$text")"
  elif [[ "$text" == *"# Memory audit report"* ]]; then
    extracted="$(awk '/^# Memory audit report/ { capture=1 } capture { print }' <<<"$text")"
  fi

  if [[ -n "$extracted" ]]; then
    printf '%s\n' "$extracted"
  fi
}

download_report_via_api() {
  local agent_id="$1"
  local dest="$2"
  local attempt list_response path download_json url

  for (( attempt=1; attempt<=ARTIFACT_RETRIES; attempt++ )); do
    list_response="$(curl -sfS \
      -u "$CURSOR_API_KEY:" \
      "$API_BASE/agents/$agent_id/artifacts" 2>/dev/null || echo '{"items":[]}')"

    path="$(echo "$list_response" | jq -r '.items[]? | select(.path | test("memory-audit-report")) | .path' | head -1)"
    if [[ -z "$path" ]]; then
      path="$REPORT_REL_PATH"
    fi

    download_json="$(curl -sfS \
      -u "$CURSOR_API_KEY:" \
      "$API_BASE/agents/$agent_id/artifacts/download?path=$(jq -rn --arg p "$path" '$p|@uri')" 2>/dev/null || true)"
    url="$(echo "$download_json" | jq -r '.url // empty')"
    if [[ -n "$url" && "$url" != "null" ]]; then
      if curl -sfS "$url" -o "$dest"; then
        echo "$path"
        return 0
      fi
    fi

    if (( attempt < ARTIFACT_RETRIES )); then
      echo "Artifact not ready (attempt $attempt/$ARTIFACT_RETRIES), retrying in ${ARTIFACT_RETRY_SECONDS}s..."
      sleep "$ARTIFACT_RETRY_SECONDS"
    fi
  done

  return 1
}

download_report_from_branch() {
  local branch="$1"
  local dest="$2"

  if [[ -z "$branch" ]] || ! command -v gh >/dev/null 2>&1; then
    return 1
  fi

  if gh api "repos/${GITHUB_REPO}/contents/${REPORT_REL_PATH}?ref=${branch}" --jq '.content' 2>/dev/null \
    | base64 --decode > "$dest"; then
    return 0
  fi

  return 1
}

write_fallback_report() {
  local agent_id="$1"
  local run_id="$2"
  local agent_url="$3"
  local status="$4"
  local duration_ms="$5"
  local branch="$6"
  local pr_url="$7"
  local result_text="$8"

  cat > "$REPORT_PATH" <<EOF
# Memory audit report (CI fallback)

CI could not download \`${REPORT_REL_PATH}\` from the artifacts API, run result, or agent branch.

- Agent: [$agent_id]($agent_url)
- Run: \`$run_id\`
- Status: \`$status\`
- Duration ms: ${duration_ms:-unknown}
- Branch: ${branch:-none}
- PR: ${pr_url:-none}

## Agent result

${result_text:-_No result text._}
EOF
}

if [[ -z "${CURSOR_API_KEY:-}" ]]; then
  echo "CURSOR_API_KEY is required" >&2
  exit 1
fi

if [[ ! -f "$PROMPT_FILE" ]]; then
  echo "Missing prompt file: $PROMPT_FILE" >&2
  exit 1
fi

mkdir -p "$ARTIFACT_DIR"

PROMPT_TEXT="$(cat "$PROMPT_FILE")"

REQUEST_BODY="$(jq -n \
  --argjson prompt "$(jq -n --arg text "$PROMPT_TEXT" '{text: $text}')" \
  --arg url "$REPO_URL" \
  --arg ref "$STARTING_REF" \
  --arg model "$MODEL_ID" \
  '{
    prompt: $prompt,
    name: "Memory audit",
    model: { id: $model },
    repos: [{ url: $url, startingRef: $ref }],
    autoCreatePR: true,
    skipReviewerRequest: true
  }')"

echo "Creating cloud agent (model=$MODEL_ID, ref=$STARTING_REF)..."

CREATE_RESPONSE="$(curl -sfS \
  -u "$CURSOR_API_KEY:" \
  -H "Content-Type: application/json" \
  -X POST "$API_BASE/agents" \
  -d "$REQUEST_BODY")"

AGENT_ID="$(echo "$CREATE_RESPONSE" | jq -r '.agent.id')"
RUN_ID="$(echo "$CREATE_RESPONSE" | jq -r '.run.id')"
AGENT_URL="$(echo "$CREATE_RESPONSE" | jq -r '.agent.url')"

echo "Agent: $AGENT_ID"
echo "Run:   $RUN_ID"
echo "URL:   $AGENT_URL"

START_EPOCH="$(date +%s)"
STATUS="CREATING"
FINAL_RESPONSE=""

while true; do
  ELAPSED=$(( $(date +%s) - START_EPOCH ))
  if (( ELAPSED > MAX_WAIT_SECONDS )); then
    echo "Timed out after ${MAX_WAIT_SECONDS}s (agent may still be running)" >&2
    STATUS="TIMEOUT"
    break
  fi

  RUN_RESPONSE="$(curl -sfS \
    -u "$CURSOR_API_KEY:" \
    "$API_BASE/agents/$AGENT_ID/runs/$RUN_ID")"

  STATUS="$(echo "$RUN_RESPONSE" | jq -r '.status')"
  echo "Status: $STATUS (${ELAPSED}s elapsed)"

  case "$STATUS" in
    FINISHED|ERROR|CANCELLED|EXPIRED)
      FINAL_RESPONSE="$RUN_RESPONSE"
      break
      ;;
  esac

  sleep "$POLL_SECONDS"
done

RESULT_TEXT=""
DURATION_MS=""
PR_URL=""
BRANCH=""
if [[ -n "$FINAL_RESPONSE" ]]; then
  RESULT_TEXT="$(echo "$FINAL_RESPONSE" | jq -r '.result // empty')"
  DURATION_MS="$(echo "$FINAL_RESPONSE" | jq -r '.durationMs // empty')"
  PR_URL="$(echo "$FINAL_RESPONSE" | jq -r '.git.branches[0].prUrl // empty')"
  BRANCH="$(echo "$FINAL_RESPONSE" | jq -r '.git.branches[0].branch // empty')"
fi

ACTIVE_NOTE_COUNT="$(find "$ROOT/memory" -maxdepth 1 -name '*.md' ! -name 'README.md' | wc -l | tr -d ' ')"

REPORT_SOURCE="fallback"
ARTIFACT_PATH=""

if ARTIFACT_PATH="$(download_report_via_api "$AGENT_ID" "$REPORT_PATH")"; then
  REPORT_SOURCE="agent"
  echo "Downloaded agent report to $REPORT_PATH ($ARTIFACT_PATH)"
elif EXTRACTED_REPORT="$(extract_report_from_result "$RESULT_TEXT")"; then
  printf '%s\n' "$EXTRACTED_REPORT" > "$REPORT_PATH"
  REPORT_SOURCE="result"
  echo "Extracted report from agent result text"
elif download_report_from_branch "$BRANCH" "$REPORT_PATH"; then
  REPORT_SOURCE="git"
  echo "Downloaded report from branch $BRANCH"
else
  write_fallback_report "$AGENT_ID" "$RUN_ID" "$AGENT_URL" "$STATUS" "$DURATION_MS" "$BRANCH" "$PR_URL" "$RESULT_TEXT"
  echo "Wrote fallback report to $REPORT_PATH"
fi

REPORT_VALID=true
WARNINGS=()

if [[ "$REPORT_SOURCE" == "fallback" ]]; then
  REPORT_VALID=false
  WARNINGS+=("could not recover report from artifacts API, run result, or agent branch")
fi

if ! grep -qE '^# Memory audit report' "$REPORT_PATH"; then
  REPORT_VALID=false
  WARNINGS+=("missing '# Memory audit report' header")
fi

if ! grep -q '^## Per-note findings' "$REPORT_PATH"; then
  REPORT_VALID=false
  WARNINGS+=("missing '## Per-note findings' section")
fi

REVIEWED_COUNT=""
if REVIEWED_LINE="$(grep -E '^- Active notes reviewed:' "$REPORT_PATH" | head -1)"; then
  REVIEWED_COUNT="$(sed -E 's/^- Active notes reviewed: *([0-9]+).*/\1/' <<<"$REVIEWED_LINE")"
elif REVIEWED_LINE="$(grep -E '^\| Reviewed \|' "$REPORT_PATH" | head -1)"; then
  REVIEWED_COUNT="$(sed -E 's/^\| Reviewed \| *([0-9]+) *\|.*/\1/' <<<"$REVIEWED_LINE")"
fi

if [[ -z "$REVIEWED_COUNT" ]]; then
  REPORT_VALID=false
  WARNINGS+=("could not parse active notes reviewed count")
elif [[ "$REVIEWED_COUNT" != "$ACTIVE_NOTE_COUNT" ]]; then
  REPORT_VALID=false
  WARNINGS+=("reviewed count ($REVIEWED_COUNT) != active note count ($ACTIVE_NOTE_COUNT)")
fi

HEALTH="ok"
EXIT_CODE=0
case "$STATUS" in
  FINISHED)
    if [[ "$REPORT_VALID" != true ]]; then
      HEALTH="degraded"
      EXIT_CODE=4
    fi
    ;;
  TIMEOUT)
    HEALTH="failed"
    EXIT_CODE=3
    WARNINGS+=("agent run timed out after ${MAX_WAIT_SECONDS}s")
    ;;
  *)
    HEALTH="failed"
    EXIT_CODE=2
    WARNINGS+=("agent run ended with status $STATUS")
    ;;
esac

WARNINGS_JSON="$(printf '%s\n' "${WARNINGS[@]:-}" | jq -R -s 'split("\n") | map(select(length > 0))')"

jq -n \
  --arg agentId "$AGENT_ID" \
  --arg runId "$RUN_ID" \
  --arg agentUrl "$AGENT_URL" \
  --arg status "$STATUS" \
  --arg health "$HEALTH" \
  --arg prUrl "$PR_URL" \
  --arg branch "$BRANCH" \
  --arg durationMs "${DURATION_MS:-}" \
  --arg completedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --arg reportSource "$REPORT_SOURCE" \
  --argjson reportValid "$REPORT_VALID" \
  --argjson activeNoteCount "$ACTIVE_NOTE_COUNT" \
  --arg reviewedCount "${REVIEWED_COUNT:-}" \
  --argjson warnings "$WARNINGS_JSON" \
  --argjson exitCode "$EXIT_CODE" \
  '{
    agentId: $agentId,
    runId: $runId,
    agentUrl: $agentUrl,
    status: $status,
    health: $health,
    prUrl: (if $prUrl == "" then null else $prUrl end),
    branch: (if $branch == "" then null else $branch end),
    durationMs: (if $durationMs == "" then null else ($durationMs | tonumber) end),
    completedAt: $completedAt,
    reportSource: $reportSource,
    reportValid: $reportValid,
    activeNoteCount: $activeNoteCount,
    reviewedCount: (if $reviewedCount == "" then null else ($reviewedCount | tonumber) end),
    warnings: $warnings,
    exitCode: $exitCode
  }' > "$META_PATH"

echo ""
echo "=== Memory audit complete ==="
echo "Status:  $STATUS"
echo "Health:  $HEALTH"
echo "Agent:   $AGENT_URL"
if [[ -n "$PR_URL" ]]; then
  echo "PR:      $PR_URL"
else
  echo "PR:      (none — no changes or agent did not open one)"
fi
echo "Report:  $REPORT_PATH ($REPORT_SOURCE, valid=$REPORT_VALID)"
echo "Notes:   active=$ACTIVE_NOTE_COUNT reviewed=${REVIEWED_COUNT:-unknown}"
if ((${#WARNINGS[@]} > 0)); then
  echo "Warnings:"
  printf '  - %s\n' "${WARNINGS[@]}"
fi
echo "Meta:    $META_PATH"

exit "$EXIT_CODE"
