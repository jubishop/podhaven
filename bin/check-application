#!/usr/bin/env python3
"""Run podhaven's repository tooling tests; bin/check --full calls this after foundation checks.

The suites in bin/tests run together, then each skill and helper suite under .agents runs as its own script.
Every suite runs even after one fails. Swift application validation stays separate; see
docs/development-workflow.md."""
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
files = subprocess.run(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", ".agents"],
                       cwd=ROOT, check=True, capture_output=True).stdout
suites = [("bin/tests", ["-m", "unittest", "discover", "-s", "bin/tests", "-p", "test_*.py", "-v"])]
for name in sorted({os.fsdecode(name) for name in files.split(b"\0") if name}):
    if Path(name).match("test_*.py") and (ROOT / name).is_file():
        suites.append((name, [name, "--verbose"]))
failed = []
for label, arguments in suites:
    print("Running " + label, flush=True)
    if subprocess.run([sys.executable, "-B", *arguments], cwd=ROOT).returncode:
        failed.append(label)
if failed:
    print("Tooling tests failed: " + ", ".join(failed), file=sys.stderr)
sys.exit(1 if failed else 0)
