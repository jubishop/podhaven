#!/usr/bin/env python3
# Copyright Justin Bishop, 2026

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / ".swift-format"
LINT_ROOTS = [
  ROOT / "PodHaven",
  ROOT / "PodHavenIntents",
  ROOT / "PodHavenMacros" / "Sources",
  ROOT / "PodHavenShare",
  ROOT / "PodHavenWidget",
]
PREVIEW_MARK_RE = re.compile(r"^// MARK: - Preview")
DIAG_RE = re.compile(
    r"^(?P<path>[^:]+):(?P<line>\d+):\d+:\s+(?:warning|error):\s+"
    r"(?:\[(?P<rule>\w+)\]\s*)?(?P<message>.*)$"
)
NOTE_RE = re.compile(r"^[^:]+:\d+:\d+:\s+note:\s")
LEVEL_RE = re.compile(r"(?:^|\s)(?:warning|error):")


def is_excluded(path: Path) -> bool:
  parts = path.parts
  if "Previews" in parts or "Preview Content" in parts:
    return True
  if path.stem.endswith("Preview"):
    return True
  return False


def preview_start_line(path: Path) -> int | None:
  for index, line in enumerate(path.read_text().splitlines(), start=1):
    if PREVIEW_MARK_RE.match(line) or line.startswith("#Preview"):
      return index
  return None


def swift_format_executable() -> str:
  override = os.environ.get("SWIFT_FORMAT")
  if override:
    return override

  if found := shutil.which("swift-format"):
    return found

  try:
    result = subprocess.run(
      ["xcrun", "--find", "swift-format"],
      check=True,
      capture_output=True,
      text=True,
    )
  except (FileNotFoundError, subprocess.CalledProcessError):
    pass
  else:
    path = result.stdout.strip()
    if path:
      return path

  print(
    "error: swift-format not found; install Xcode or set SWIFT_FORMAT",
    file=sys.stderr,
  )
  sys.exit(1)


def production_swift_files() -> list[Path]:
  files: list[Path] = []
  for root in LINT_ROOTS:
    if not root.exists():
      continue
    for path in sorted(root.rglob("*.swift")):
      if ".build" in path.parts:
        continue
      if is_excluded(path):
        continue
      files.append(path)
  return files


def main() -> int:
  if not CONFIG.is_file():
    print(f"error: missing swift-format config at {CONFIG}", file=sys.stderr)
    return 1

  files = production_swift_files()
  if not files:
    print("error: no production Swift files found to lint", file=sys.stderr)
    return 1

  preview_starts = {path: preview_start_line(path) for path in files}

  swift_format = swift_format_executable()

  try:
    result = subprocess.run(
      [
        swift_format,
        "lint",
        "--configuration",
        str(CONFIG),
        "--strict",
        "--parallel",
        *[str(path) for path in files],
      ],
      cwd=ROOT,
      capture_output=True,
      text=True,
    )
  except OSError as error:
    print(f"error: could not run swift-format at {swift_format}: {error}", file=sys.stderr)
    return 1

  output = result.stdout + result.stderr
  diagnostics: list[str] = []
  report: list[str] = []
  other_output: list[str] = []
  seen: set[tuple[str, int, str]] = set()
  preview_findings = 0
  reporting_notes = False

  for line in output.splitlines():
    if not line.strip():
      continue

    if NOTE_RE.match(line):
      if reporting_notes:
        report.append(line)
      continue
    reporting_notes = False

    if match := DIAG_RE.match(line):
      path = Path(match.group("path"))
      if not path.is_absolute():
        path = ROOT / path

      line_number = int(match.group("line"))
      rule = match.group("rule")
      preview_line = preview_starts.get(path)
      if rule and preview_line is not None and line_number >= preview_line:
        preview_findings += 1
        continue

      key = (str(path), line_number, rule or match.group("message"))
    elif LEVEL_RE.search(line):
      key = ("", 0, line)
    else:
      other_output.append(line)
      continue

    if key in seen:
      continue
    seen.add(key)
    diagnostics.append(line)
    report.append(line)
    reporting_notes = True

  if diagnostics:
    for line in [*report, *other_output]:
      print(line, file=sys.stderr)
    print(
      f"swift-format lint failed with {len(diagnostics)} issue(s) in production code",
      file=sys.stderr,
    )
    return 1

  preview_findings_explain_exit = result.returncode == 1 and preview_findings and not other_output
  if result.returncode != 0 and not preview_findings_explain_exit:
    sys.stderr.write(output)
    print(
      f"error: swift-format lint exited with status {result.returncode}"
      " without reporting a production-code issue",
      file=sys.stderr,
    )
    return 1

  print(f"swift-format lint passed ({len(files)} production files)")
  return 0


if __name__ == "__main__":
  sys.exit(main())
