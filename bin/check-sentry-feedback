#!/bin/bash

set -euo pipefail

# shellcheck source=bin/_sentry_intake.sh
source "$(dirname "${BASH_SOURCE[0]}")/_sentry_intake.sh"

LABEL="sentry-feedback"
COMMENT_MARKER="sfeedback"
ANALYSIS_SKILL="analyze-sentry-feedback"
TRIAGE_COMMAND="bin/snfeedback"
SENTRY_DETAILS="Protected feedback details"
CREATED=0

intake_start 'issue.category:feedback is:unresolved' feedback 'feedback items'

while IFS= read -r feedback; do
  ID="$(jq -r '.id' <<< "$feedback")"
  SHORT_ID="$(jq -r '.shortId' <<< "$feedback")"
  PERMALINK="$(jq -r '.permalink' <<< "$feedback")"
  SLUG="podhaven:$ID"
  ISSUE_MARKER="<!-- sentry-feedback:$SLUG -->"

  # Each feedback item is one submission, so its tracking issue stays its record even after closing.
  MATCH="$(jq -c \
    --arg marker "$ISSUE_MARKER" \
    --arg permalink "$PERMALINK" \
    '(
      first(.[] | select((.body // "") | contains($marker)))
      // first(.[] | select((.body // "") | contains($permalink)))
      // empty
    ) | . + {
      analyzed: ((.body // "")
        | contains("<!-- analyze-sentry-feedback-findings:start -->")
          and contains("<!-- analyze-sentry-feedback-findings:end -->"))
    }' \
    "$ISSUES_JSON")"

  if [[ -n "$MATCH" ]]; then
    intake_track "$MATCH" "$SLUG" "$SLUG" "$PERMALINK"
    continue
  fi

  BODY_PATH="$WORK_DIR/issue-body.md"
  {
    printf '%s\n' "$ISSUE_MARKER"
    printf 'An unresolved Sentry user feedback item needs triage.\n\n'
    printf -- '- **Feedback:** [%s](%s)\n' "$SLUG" "$PERMALINK"
    printf -- "- **Sentry reference:** \`%s\`\n\n" "$SHORT_ID"
    printf 'The feedback text and reporter details remain in Sentry because this repository is public.\n'
  } > "$BODY_PATH"
  intake_create CREATED "Triage Sentry feedback $SHORT_ID" " ($SLUG)" "$BODY_PATH" "$SLUG" "$SLUG" "$PERMALINK"
done < <(intake_items)

intake_finish "Sentry feedback check" \
  "Found $TOTAL unresolved feedback item(s): created $CREATED issue(s), found $TRACKED already tracked, added $COMMENTS_ADDED instruction comment(s)."
