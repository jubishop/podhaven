#!/usr/bin/env python3
"""Run all automated tests, on this Mac or the second Mac, and retain evidence for the tested checkout."""

import argparse
import calendar
from contextlib import ExitStack, contextmanager, suppress
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import plistlib
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time

sys.dont_write_bytecode = True
from _my_mac_lock import current_holder, inherited, lock_path, my_mac_lock
import _test_lane
import _test_lane_host
from _validation_slot import HOLDER_VARIABLE, busy, validation_slot
from _worktrees import require_private_packages

ROOT = Path(__file__).resolve().parents[1]
DESTINATION = "platform=macOS,name=My Mac"
RETAINED_RUNS = 5
EVIDENCE_NAME = re.compile(r"\d{8}-\d{6}-\w+")
# Xcode chooses the SDK for each destination, so nothing this run starts inherits one, Git included.
os.environ.pop("SDKROOT", None)
TEST_ENVIRONMENT = dict(os.environ)
HOST_PID = re.compile(rb" - PodHaven \((\d+)\)'")
# xcodebuild's first line. Anything before it, such as a wrapper waiting for a build slot, isn't the build.
XCODEBUILD_STARTED = b"Command line invocation:"
# The test host names itself in its own output, which a timing phase's log shows first, and XCTest names it too.
TEST_HOST_STARTED = re.compile(rb" PodHaven\[\d+:| - PodHaven \(\d+\)'")
QUIET_LOG_SECONDS = 120
SAMPLE_GAP_SECONDS = 60
SAMPLE_SECONDS = 10
SAMPLE_TIMEOUT_SECONDS = 120
# A build has stalled once its log stays quiet, and its processes use under BUILD_IDLE_CPU_SECONDS, for this long.
BUILD_STALL_SECONDS = 300
BUILD_IDLE_CPU_SECONDS = 3
BUILD_POLL_SECONDS = 10
# How long a stalled xcodebuild has to stop after its interrupt before it is killed.
STOP_SECONDS = 30
POLL_SECONDS = 1
LOAD_SAMPLE_SECONDS = 5
# How often a run that waits for a lane looks for a free one on this Mac and on the second Mac.
LANE_POLL_SECONDS = 1
REMOTE_POLL_SECONDS = 30
TEST_HOST = "com.artisanalsoftware.PodHaven.debug"
# Timing suites each run alone in their own test host after the other app tests, so
# no other test's work counts against their budgets: (result bundle, log, suite).
TIMING_PHASES = (
    ("SiriPerformance", "siri-performance", "SiriLargeCatalogTests"),
    ("OPMLPerformance", "opml-performance", "OPMLLargeImportTests"),
)
SWIFT_PHASES = (
    ("TestResults", "xcodebuild", "swift-validation",
     [f"-skip-testing:PodHavenTests/{suite}" for _, _, suite in TIMING_PHASES], ["--full"]),
    *((bundle, log, f"{log}-validation", [f"-only-testing:PodHavenTests/{suite}"], [])
      for bundle, log, suite in TIMING_PHASES),
)
# The system, not the tests, keeps these in the test host's temporary directory.
TEST_HOST_SYSTEM_ENTRIES = {"TemporaryItems", f"{TEST_HOST}.savedState"}
# Xcode names the directory where each run's test host writes coverage profiles with
# ProcessInfo.globallyUniqueString, which holds the pid of the process that made it.
COVERAGE_DIRECTORY = re.compile(r"[0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12}-(\d+)-[0-9A-F]{16}")
# Xcode builds the macros from the app's pins; swift test uses the macro package's own.
APP_PINS = ROOT / "PodHaven.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
MACRO_PINS = ROOT / "PodHavenMacros/Package.resolved"
# An incremental build compiles only what changed, so its log misses warnings in files an earlier build compiled.
# Each run removes the project's own builds, so it compiles every project source again; package dependencies' builds
# stay. Of Xcode's intermediates, it removes the build database first, since a module cache removed under it breaks
# later builds; the explicit module caches, which go stale when a binary package's pins change, because its headers
# keep older times; and the builds of the project and the local macro package. swift test builds the macro
# package's own targets in MACRO_OWN_BUILD.
XCODE_REBUILT = ("XCBuildData", "SwiftExplicitPrecompiledModules", "ExplicitPrecompiledModules",
                 "PodHaven.build", "PodHavenMacros.build")
MACRO_OWN_BUILD = ROOT / "PodHavenMacros/.build/out/Intermediates.noindex/PodHavenMacros.build"
# swift test colors its diagnostics even when its output goes to a file.
TERMINAL_ESCAPE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\))")


def capture(*command):
    return subprocess.check_output(command, cwd=ROOT, env=TEST_ENVIRONMENT,
                                   text=True, stderr=subprocess.STDOUT).strip()


def checkout_state():
    revision = capture("git", "rev-parse", "HEAD")
    digest = hashlib.sha256()
    files = subprocess.check_output(
        ["git", "ls-files", "-v", "--cached", "--others", "--exclude-standard", "-z"],
        cwd=ROOT, env=TEST_ENVIRONMENT)
    entries = {part for part in files.split(b"\0") if part}
    unchecked_paths = sorted(os.fsdecode(entry[2:]) for entry in entries
                             if entry[:1] == b"S" or entry[:1].islower())
    for name in sorted({entry[2:] for entry in entries}):
        path = ROOT / os.fsdecode(name)
        if not path.is_file() and not path.is_symlink():
            continue
        contents = os.fsencode(os.readlink(path)) if path.is_symlink() else path.read_bytes()
        mode = str(path.lstat().st_mode).encode()
        digest.update(name + b"\0" + mode + b"\0" + hashlib.sha256(contents).digest())
    return {"revision": revision, "worktree_sha256": digest.hexdigest(), "unchecked_paths": unchecked_paths,
            "status": capture("git", "status", "--porcelain=v1", "--untracked-files=all")}


def package_pins(path):
    try:
        return {pin["identity"]: pin["state"] for pin in json.loads(path.read_text())["pins"]}
    except (OSError, ValueError, KeyError, TypeError) as error:
        raise RuntimeError(f"Could not read package pins from {path.relative_to(ROOT)}: {error!r}") from error


def check_macro_pins():
    def label(state):
        if state is None:
            return "none"
        return " ".join(filter(None, (state.get("version") or state.get("branch"), state.get("revision", "")[:12])))

    app = package_pins(APP_PINS)
    mismatches = [f"{identity} (macros {label(state)}, app {label(app.get(identity))})"
                  for identity, state in sorted(package_pins(MACRO_PINS).items()) if app.get(identity) != state]
    if mismatches:
        raise RuntimeError(f"{MACRO_PINS.relative_to(ROOT)} must pin what the app's Package.resolved pins, "
                           f"since Xcode builds the macros from the app's pins: {', '.join(mismatches)}")


def xcode_rebuilt():
    """Return the folders of Xcode's intermediates that each run removes, in the order to remove them."""
    result = subprocess.run(["xcodebuild", "-hideShellScriptEnvironment", "-project", "PodHaven.xcodeproj",
                             "-scheme", "PodHaven", "-destination", DESTINATION, "-skipMacroValidation",
                             "-showBuildSettings", "-json"],
                            cwd=ROOT, env=TEST_ENVIRONMENT, capture_output=True, text=True)
    try:
        roots = {target["buildSettings"]["OBJROOT"] for target in json.loads(result.stdout)}
    except (ValueError, KeyError, TypeError):
        roots = set()
    if result.returncode or len(roots) != 1:
        raise RuntimeError("Could not read Xcode's intermediates folder from its build settings: "
                           + "\n".join(result.stderr.strip().splitlines()[-5:]))
    (root,) = roots
    return [Path(root) / name for name in XCODE_REBUILT]


def remove_builds(folders):
    for folder in folders:
        if folder.exists():
            shutil.rmtree(folder)


def require_builds(folders, log):
    """Fail unless the build remade every folder removed before it, as it does when it builds there."""
    missing = [str(folder) for folder in folders if not folder.is_dir()]
    if missing:
        raise RuntimeError(f"The build didn't remake {', '.join(missing)}, so it may not have compiled every "
                           f"project source; update the folders bin/test-all removes. See {log}")


def host_alive(pid):
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def process_table():
    """Return each process's parent, start time, CPU seconds, and executable, by process ID."""
    table = {}
    for line in subprocess.check_output(["ps", "-A", "-o", "pid=,ppid=,lstart=,time=,comm="], text=True,
                                        env={**TEST_ENVIRONMENT, "LC_ALL": "C"}).splitlines():
        pid, parent, *start, used, command = line.split(None, 8)
        minutes, _, seconds = used.rpartition(":")
        table[int(pid)] = (int(parent), " ".join(start), int(minutes or 0) * 60 + float(seconds), command)
    return table


def process_tree(table, root):
    """Return the entries in table for root and every process descended from it."""
    tree, pending = {}, [root]
    while pending:
        pid = pending.pop()
        if pid in table and pid not in tree:
            tree[pid] = table[pid]
            pending.extend(child for child, (parent, *_) in table.items() if parent == pid)
    return tree


def sample(targets):
    """Sample each process in targets, a list of (pid, description, path), all at once."""
    deadline = time.monotonic() + SAMPLE_TIMEOUT_SECONDS
    samplers = []
    for pid, description, path in targets:
        try:
            samplers.append((description, path, subprocess.Popen(
                ["sample", str(pid), str(SAMPLE_SECONDS), "-mayDie", "-file", str(path)], env=TEST_ENVIRONMENT,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)))
        except OSError as error:
            print(f"Could not sample {description}: {error}", file=sys.stderr, flush=True)
    for description, path, sampler in samplers:
        try:
            output = sampler.communicate(timeout=max(0, deadline - time.monotonic()))[0]
            failure = f"exit code {sampler.returncode}: {output}".strip() if sampler.returncode else ""
        except subprocess.TimeoutExpired as error:
            sampler.kill()
            sampler.communicate()
            failure = str(error)
        if failure or not path.is_file():
            print(f"Could not sample {description}: {failure or 'sample wrote no report'}",
                  file=sys.stderr, flush=True)
        else:
            print(f"Sampled {description}: {path}", file=sys.stderr, flush=True)


def sample_stalled_host(process, log, host):
    """Sample the test host twice, SAMPLE_GAP_SECONDS apart, unless xcodebuild ends first."""
    print(f"{log} has not grown for {QUIET_LOG_SECONDS} seconds while test host {host} runs; sampling it",
          file=sys.stderr, flush=True)
    sample([(host, f"test host {host}", log.with_name(f"{log.stem}-host-{host}-1.sample.txt"))])
    try:
        process.wait(timeout=SAMPLE_GAP_SECONDS)
        return
    except subprocess.TimeoutExpired:
        pass
    sample([(host, f"test host {host}", log.with_name(f"{log.stem}-host-{host}-2.sample.txt"))])


def stop_stalled_build(process, log, tree):
    """Sample a stalled build's processes, then stop them all, since any of them may hold the run's slots and locks.

    Return the error that fails the phase."""
    print(f"xcodebuild has made no progress for {BUILD_STALL_SECONDS} seconds before any test host started: {log} "
          f"has not grown, and its processes used under {BUILD_IDLE_CPU_SECONDS} CPU seconds; sampling and stopping them",
          file=sys.stderr, flush=True)
    targets = []
    for pid, (_, _, _, command) in tree.items():
        executable = re.sub(r"[^\w.-]", "_", Path(command).name)
        targets.append((pid, f"{executable} {pid}", log.with_name(f"{log.stem}-build-{executable}-{pid}.sample.txt")))
    sample(targets)
    tree = process_tree(process_table(), process.pid)
    process.send_signal(signal.SIGINT)
    try:
        process.wait(timeout=STOP_SECONDS)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()
    # A process that outlives xcodebuild is still the one it started only while its start time matches.
    table = process_table()
    for pid, (_, start, _, _) in tree.items():
        if pid != process.pid and pid in table and table[pid][1] == start:
            with suppress(ProcessLookupError):
                os.kill(pid, signal.SIGKILL)
    samples = "".join(f"\nBuild sample: {path}" for _, _, path in targets if path.is_file())
    return f"xcodebuild stalled before its tests started ({log.stem}), so bin/test-all stopped it; see {log}{samples}"


def watch_xcodebuild(process, log):
    """Watch an xcodebuild test run's log until it ends, to stop a build that stalls and sample a test host that does.

    The build has stalled when, after xcodebuild starts and before any test host does, its log stays quiet and its
    processes stay idle for BUILD_STALL_SECONDS. Return the error that fails the phase, or None."""
    with log.open("rb") as reader:
        recent, host, started, testing = b"", None, False, False
        quiet_since = idle_since = next_poll = time.monotonic()
        idle_cpu, seen = 0.0, {}
        while True:
            try:
                process.wait(timeout=POLL_SECONDS)
                return None
            except subprocess.TimeoutExpired:
                pass
            now = time.monotonic()
            if chunk := reader.read():
                quiet_since = idle_since = now
                idle_cpu = 0.0
                recent += chunk
                started = started or XCODEBUILD_STARTED in recent
                testing = testing or bool(TEST_HOST_STARTED.search(recent))
                hosts = HOST_PID.findall(recent)
                host = int(hosts[-1]) if hosts else host
                recent = recent[-64:]
            elif host and now - quiet_since >= QUIET_LOG_SECONDS and host_alive(host):
                sample_stalled_host(process, log, host)
                return None
            if started and not testing and now >= next_poll:
                next_poll = now + BUILD_POLL_SECONDS
                tree = process_tree(process_table(), process.pid)
                # A process started since the last poll counts all its CPU time.
                used = {(pid, start): cpu for pid, (_, start, cpu, _) in tree.items()}
                idle_cpu += sum(max(0.0, cpu - seen.get(key, 0.0)) for key, cpu in used.items())
                seen = used
                if idle_cpu >= BUILD_IDLE_CPU_SECONDS:
                    idle_since, idle_cpu = now, 0.0
                elif now - idle_since >= BUILD_STALL_SECONDS and process.poll() is None:
                    return stop_stalled_build(process, log, tree)


def run(command, output, name, *, check=True, require_unittest=False, pass_fds=(), watch=False):
    log = output / f"{name}.log"
    print(f"Running {name}; log: {log}", flush=True)
    with log.open("w") as stream, subprocess.Popen(command, cwd=ROOT, env=TEST_ENVIRONMENT, stdout=stream,
                                                   stderr=subprocess.STDOUT, pass_fds=pass_fds) as process:
        stall = watch_xcodebuild(process, log) if watch else None
        returncode = process.wait()
    if returncode:
        print("\n".join(log.read_text(errors="replace").splitlines()[-35:]), file=sys.stderr)
    if stall or returncode and check:
        raise RuntimeError(stall or f"{name} failed with exit code {returncode}; see {log}")
    if require_unittest:
        contents = log.read_text(errors="replace")
        counts = re.findall(r"^Ran (\d+) tests? in ", contents, re.M)
        if not counts or not all(map(int, counts)) or re.search(r"\bskipped=[1-9]\d*", contents):
            raise RuntimeError(f"{name} has skipped or missing tests; see {log}")
    return returncode


def load_sample():
    return {"at": datetime.now(timezone.utc).isoformat(),
            "load_averages": [round(load, 2) for load in os.getloadavg()], "cores": os.cpu_count()}


@contextmanager
def phase(report, name):
    """Record the host's load at the start and end of a phase and its peak 1-minute load while the phase runs.

    A phase fails when its command fails or a check of its output does. When the peak exceeded twice the core
    count, the report says the failure may be load-induced; it still fails."""
    record = {"result": "failed", "start": load_sample()}
    report.setdefault("phases", {})[name] = record
    peak = record["start"]["load_averages"][0]
    finished = threading.Event()

    def sample():
        nonlocal peak
        while not finished.wait(LOAD_SAMPLE_SECONDS):
            peak = max(peak, os.getloadavg()[0])

    sampler = threading.Thread(target=sample, daemon=True)
    sampler.start()
    try:
        yield
        record["result"] = "passed"
    finally:
        finished.set()
        sampler.join()
        record["end"] = load_sample()
        record["peak_load_1m"] = round(max(peak, record["end"]["load_averages"][0]), 2)
        cores = record["end"]["cores"]
        record["saturated"] = record["peak_load_1m"] > 2 * cores
        if record["result"] == "failed" and record["saturated"]:
            report["saturation"] = (f"The host was saturated during {name}: its 1-minute load peaked at "
                                    f"{record['peak_load_1m']}, above twice its {cores} cores, "
                                    "so this failure may be load-induced.")


def test_host_data():
    for metadata in (Path.home() / "Library/Containers").glob("*/.com.apple.containermanagerd.metadata.plist"):
        try:
            with metadata.open("rb") as stream:
                identity = plistlib.load(stream)
        except (OSError, ValueError):
            continue
        if isinstance(identity, dict) and identity.get("MCMMetadataIdentifier") == TEST_HOST:
            return metadata.parent / "Data"
    return None


def test_host_temporary_entries(data):
    return set(os.listdir(data / "tmp")) if data and (data / "tmp").is_dir() else set()


def remove_finished_coverage_directories(data):
    """Remove each coverage directory in the test host's container once the process that made it ends."""
    if data is None or not data.is_dir():
        return
    directories = [(entry, int(match[1])) for entry in os.scandir(data)
                   if (match := COVERAGE_DIRECTORY.fullmatch(entry.name)) and entry.is_dir(follow_symlinks=False)]
    if not directories:
        return
    # List processes after the directories, so every maker that is still alive appears.
    started = {}
    for line in subprocess.check_output(["ps", "-A", "-o", "pid=,lstart="], text=True,
                                        env={**TEST_ENVIRONMENT, "TZ": "UTC0", "LC_ALL": "C"}).splitlines():
        pid, start = line.split(None, 1)
        started[int(pid)] = calendar.timegm(time.strptime(" ".join(start.split()), "%a %b %d %H:%M:%S %Y"))
    for entry, pid in directories:
        # A process that started after the directory reuses the pid of the one that made it.
        if pid not in started or started[pid] > entry.stat(follow_symlinks=False).st_birthtime:
            shutil.rmtree(entry.path)


def evidence_files(output):
    return {str(path.relative_to(output)): hashlib.sha256(path.read_bytes()).hexdigest()
            for path in sorted(output.rglob("*")) if path.is_file() and path != output / "run.json"}


def prune_evidence(cache, current):
    earlier = sorted((path for path in cache.iterdir()
                      if path != current and EVIDENCE_NAME.fullmatch(path.name)
                      and not path.is_symlink() and path.is_dir()),
                     key=lambda path: path.stat().st_mtime_ns, reverse=True)
    for path in earlier[RETAINED_RUNS - 1:]:
        shutil.rmtree(path)


def reusable_evidence(report):
    """Return the newest retained run that passed for this checkout and toolchain, or None."""
    try:
        outputs = sorted((path for path in (ROOT / ".cache/test-all").glob("*") if path.is_dir()),
                         key=lambda path: path.stat().st_mtime_ns, reverse=True)
    except OSError:
        return None
    for output in outputs:
        try:
            saved = json.loads((output / "run.json").read_text())
            if (saved.get("schema") != 1 or saved.get("result") != "passed"
                    or not saved.get("finished_at")
                    or any(saved.get(key) != report[key]
                           for key in ("checkout", "destination", "xcode", "swift", "macos"))
                    or saved.get("checkout_after") != report["checkout"]):
                continue
            artifacts = saved.get("artifacts")
            if (not isinstance(artifacts, dict)
                    or not {"tooling.log", "macros.log",
                            *(f"{name}.log" for _, log, validation, _, _ in SWIFT_PHASES
                              for name in (log, validation))} <= artifacts.keys()
                    or not all((output / f"{bundle}.xcresult").is_dir() for bundle, *_ in SWIFT_PHASES)
                    or evidence_files(output) != artifacts
                    or checkout_state() != report["checkout"]):
                continue
            return output
        except (OSError, ValueError, AttributeError):
            continue
    return None


def new_output(cache):
    cache.mkdir(parents=True, exist_ok=True)
    return Path(tempfile.mkdtemp(prefix=datetime.now().strftime("%Y%m%d-%H%M%S-"), dir=cache))


def local_lane_holder():
    """Return what holds this Mac's lane, or None when a run here would start at once."""
    holder = current_holder()
    if holder is not None:
        return f"its My Mac test lock is held by {holder or 'another run'}"
    return busy()


def second_mac(report):
    """Return the second Mac when podhaven.testHost names one this run can use, else None, saying why."""
    host = _test_lane.configured_host(ROOT, TEST_ENVIRONMENT)
    if not host:
        return None
    checkout = report["checkout"]
    if inherited(lock_path()):
        reason = "it runs under the My Mac test lock it inherited"
    elif checkout["status"] or checkout["unchecked_paths"]:
        reason = "the checkout has uncommitted changes, and the second Mac runs only commits"
    else:
        lane = _test_lane.SecondMac(host, ROOT, TEST_ENVIRONMENT)
        refusal = lane.refusal(report)
        if not refusal:
            return lane
        reason = f"the second Mac, {host}, can't run it: {refusal}"
    print(f"Running on this Mac: {reason}", flush=True)
    return None


def run_on_second_mac(lane, report, cache):
    """Take the second Mac's lane or this Mac's, whichever is free first, and run in the second Mac's if it is.

    Return the second Mac's evidence folder and report once its run ends, or None to run here instead."""
    revision = report["checkout"]["revision"]
    # bin/check's whitespace check reads only the changes since origin's default branch, so the lane gets it too.
    base = subprocess.run(["git", "rev-parse", "--verify", "--quiet", "refs/remotes/origin/HEAD^{commit}"], cwd=ROOT,
                          env=TEST_ENVIRONMENT, capture_output=True, text=True).stdout.strip()
    attempted = waiting = None
    while True:
        if attempted is None or time.monotonic() - attempted >= REMOTE_POLL_SECONDS:
            attempted = time.monotonic()
            failure = lane.push(*filter(None, (revision, base)))
            if failure:
                print(f"Running on this Mac: the second Mac, {lane.host}, can't run it: {failure}", flush=True)
                return None
            output = new_output(cache)
            attempt = lane.attempt(revision, base, output)
            if attempt:
                prune_evidence(cache, output)
                return second_mac_run(lane, report, output, *attempt)
            output.rmdir()
        local = local_lane_holder()
        if local is None:
            print(f"Running on this Mac: the second Mac's lane is held by {lane.holder}, and this Mac's is free",
                  flush=True)
            return None
        if not waiting:
            print(f"Waiting for the second Mac's lane, held by {lane.holder}, or this Mac's: {local}",
                  file=sys.stderr, flush=True)
            waiting = True
        time.sleep(LANE_POLL_SECONDS)


def second_mac_run(lane, report, output, status, remote_output):
    """Return the second Mac's evidence folder and report, or None to run here when its run can't count."""
    try:
        remote = json.loads((output / "run.json").read_text())
    except (OSError, ValueError):
        remote = None
    if isinstance(remote, dict) and remote.get("schema") == 1:
        if remote_output and isinstance(remote.get("error"), str):
            remote["error"] = remote["error"].replace(remote_output, str(output))
        if remote.get("result") == "passed" or not lane.request_signing_renewal(output):
            return output, remote
        reason = (f"the second Mac, {lane.host}, couldn't sign the test host, so bin/test-all asked it to renew its "
                  "signing")
    elif status == _test_lane.UNREACHABLE:
        reason = f"the connection to the second Mac, {lane.host}, failed during its run"
    elif status == _test_lane_host.STOPPED:
        reason = f"the second Mac, {lane.host}, stopped its run when this Mac's heartbeat ended"
    else:
        reason = f"the second Mac, {lane.host}, ended its run with exit status {status} and no report"
    if any(output.iterdir()):
        (output / "run.json").write_text(json.dumps(
            {**report, "remote": {"host": lane.host, **(remote or {})}, "error": reason,
             "finished_at": datetime.now(timezone.utc).isoformat()}, indent=2) + "\n")
    else:
        output.rmdir()
    print(f"Running on this Mac: {reason}", flush=True)
    return None


def accept_second_mac_run(report, output, remote, host):
    """Record the second Mac's run in report, and fail unless it passed for exactly this checkout's commit."""
    report["remote"] = {"host": host, **{key: remote.get(key) for key in (
        "result", "error", "started_at", "finished_at", "destination", "xcode", "swift", "macos",
        "checkout", "checkout_after")}}
    for key in ("phases", "saturation"):
        if key in remote:
            report[key] = remote[key]
    if remote.get("result") != "passed":
        report["error"] = remote.get("error") or "bin/test-all failed"
        raise RuntimeError(f"bin/test-all failed on the second Mac; its evidence is in {output}")
    checkout = remote.get("checkout")
    if (not isinstance(checkout, dict) or checkout.get("revision") != report["checkout"]["revision"]
            or checkout.get("status") or checkout.get("unchecked_paths") or remote.get("checkout_after") != checkout):
        raise RuntimeError("The second Mac's run did not test exactly this checkout's commit")
    if any(remote.get(key) != report[key] for key in ("destination", "xcode", "swift", "macos")):
        raise RuntimeError("The second Mac's run used another toolchain or destination than this Mac's")
    if remote.get("artifacts") != evidence_files(output):
        raise RuntimeError(f"The second Mac's evidence in {output} doesn't match its report")


def run_here(report, output):
    """Run every phase on this Mac, holding the My Mac test lock for its xcodebuild test phases."""
    with phase(report, "tooling"):
        run([str(ROOT / "bin/check"), "--full", "--no-reuse"], output, "tooling", require_unittest=True)
    with phase(report, "swift-lint"):
        run([str(ROOT / "bin/lint-swift-format")], output, "swift-lint")
    with phase(report, "macros"):
        remove_builds([MACRO_OWN_BUILD])
        run(["xcrun", "swift", "test", "--package-path", "PodHavenMacros"], output, "macros")
        require_builds([MACRO_OWN_BUILD], output / "macros.log")
        macro_log = TERMINAL_ESCAPE.sub("", (output / "macros.log").read_text(errors="replace"))
        if re.search(r"(?:^|\s)warning:", macro_log, re.I):
            raise RuntimeError(f"Macro tests emitted warnings; see {output / 'macros.log'}")
        if not re.search(r"Executed [1-9]\d* tests?", macro_log):
            raise RuntimeError(f"No executed macro tests found; see {output / 'macros.log'}")
        if re.search(r"\b[1-9]\d* (?:tests? )?skipped\b", macro_log, re.I):
            raise RuntimeError(f"Macro tests were skipped; see {output / 'macros.log'}")

    with my_mac_lock(f"bin/test-all in {ROOT}") as lock:
        earlier_entries = test_host_temporary_entries(test_host_data())
        try:
            for number, (bundle_name, log_name, validation_name, selection, validation_options) in enumerate(
                    SWIFT_PHASES):
                with phase(report, log_name):
                    # The first build compiles every project source; the timing phases' builds then compile none.
                    rebuilt = [] if number else xcode_rebuilt()
                    remove_builds(rebuilt)
                    bundle = output / f"{bundle_name}.xcresult"
                    test_status = run([
                        "xcodebuild", "test", "-hideShellScriptEnvironment", "-project", "PodHaven.xcodeproj",
                        "-scheme", "PodHaven", "-testPlan", "PodHaven", "-destination", DESTINATION,
                        "-skipMacroValidation", "-resultBundlePath", str(bundle), *selection,
                        "LM_FORCE_LINK_GENERATION=YES",
                    ], output, log_name, check=False, pass_fds=(lock,), watch=True)
                    samples = "".join(f"\nTest host sample: {path}"
                                      for path in sorted(output.glob(f"{log_name}-host-*.sample.txt")))
                    if not bundle.is_dir():
                        raise RuntimeError(f"Swift tests did not produce a result bundle (exit code "
                                           f"{test_status}); see {output / (log_name + '.log')} for the "
                                           f"launch or build failure{samples}")
                    validation_status = run([
                        str(ROOT / "bin/check-swift-results"), str(bundle),
                        "--build-log", str(output / f"{log_name}.log"), *validation_options,
                    ], output, validation_name, check=False)
                    if test_status or validation_status:
                        raise RuntimeError(f"Swift tests or evidence validation failed ({log_name}){samples}")
                    require_builds(rebuilt, output / f"{log_name}.log")
        finally:
            remove_finished_coverage_directories(test_host_data())
        data = test_host_data()
        if data is None:
            raise RuntimeError(f"Could not find the {TEST_HOST} container that ran the tests")
        left = sorted(test_host_temporary_entries(data) - earlier_entries - TEST_HOST_SYSTEM_ENTRIES)
        if left:
            raise RuntimeError(f"Tests left {len(left)} new entries in {data / 'tmp'}: {', '.join(left[:10])}"
                               "; put test files under TestFiles.uniqueURL()")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--ensure", action="store_true", help="Require clean full evidence; run tests if reuse is unavailable.")
    mode.add_argument("--verify", action="store_true", help="Verify existing clean full evidence without running tests.")
    mode.add_argument("--preflight", action="store_true",
                      help="Check the toolchain and prepare this checkout's Xcode packages without running tests.")
    parser.add_argument("--revision", help="Require this exact commit for --ensure or --verify.")
    args = parser.parse_args()
    if args.revision and not (args.ensure or args.verify):
        parser.error("--revision requires --ensure or --verify")
    output = None
    held = ExitStack()
    report = {"schema": 1, "result": "failed", "started_at": datetime.now(timezone.utc).isoformat(),
              "destination": DESTINATION}
    try:
        if Path(capture("git", "rev-parse", "--show-toplevel")).resolve() != ROOT:
            raise RuntimeError("Git must use this checkout; clear inherited Git repository selectors")
        report["xcode"] = capture("xcodebuild", "-hideShellScriptEnvironment", "-version")
        report["swift"] = capture("xcrun", "swift", "--version")
        report["macos"] = capture("sw_vers", "-productVersion")
        xcode = re.search(r"Xcode (\d+)", report["xcode"])
        swift = re.search(r"Swift version (\d+)\.(\d+)", report["swift"])
        if int(report["macos"].split(".")[0]) < 27:
            raise RuntimeError(f"My Mac tests require macOS 27+; detected {report['macos']}. Use a supported Mac.")
        if not xcode or int(xcode[1]) < 27 or not swift or tuple(map(int, swift.groups())) < (6, 4):
            raise RuntimeError(f"Xcode 27+ and Swift 6.4+ are required; select Xcode with DEVELOPER_DIR.\n"
                               f"{report['xcode']}\n{report['swift']}")
        # In every mode, since release commands run the preflight before their own Xcode builds.
        require_private_packages(ROOT)
        if args.preflight:
            return 0
        report["checkout"] = checkout_state()
        if args.ensure or args.verify:
            if report["checkout"]["unchecked_paths"]:
                raise RuntimeError("Release validation requires clearing Git assume-unchanged and skip-worktree flags: "
                                   + ", ".join(report["checkout"]["unchecked_paths"]))
            if report["checkout"]["status"]:
                raise RuntimeError("Release validation requires a fully clean working tree. Commit your changes first.")
            if args.revision and report["checkout"]["revision"] != args.revision:
                raise RuntimeError("Checkout revision changed; restart the release from the intended commit")
            evidence = reusable_evidence(report)
            if evidence:
                print(f"Verified full local test evidence: {evidence}", flush=True)
                return 0
            if args.verify:
                raise RuntimeError("No valid full local test evidence for this clean revision and toolchain; run bin/test-all")
        check_macro_pins()
        cache = ROOT / ".cache/test-all"
        lane = second_mac(report)
        finished = run_on_second_mac(lane, report, cache) if lane else None
        if finished:
            output, remote = finished
            accept_second_mac_run(report, output, remote, lane.host)
        else:
            held.enter_context(validation_slot(f"bin/test-all in {ROOT}"))
            TEST_ENVIRONMENT[HOLDER_VARIABLE] = os.environ[HOLDER_VARIABLE]
            output = new_output(cache)
            print(f"Test evidence: {output}", flush=True)
            prune_evidence(cache, output)
            run_here(report, output)
        report["checkout_after"] = checkout_state()
        if any(report["checkout_after"][key] != report["checkout"][key]
               for key in ("revision", "worktree_sha256")):
            raise RuntimeError("Checkout changed during testing; rerun bin/test-all for the final changes")
        if args.ensure and (report["checkout_after"]["status"] or report["checkout_after"]["unchecked_paths"]):
            raise RuntimeError("Checkout is no longer clean; resolve changes and rerun bin/test-all")
        report["artifacts"] = evidence_files(output)
        report["result"] = "passed"
        passed = f"All tests passed on the second Mac, {lane.host}" if finished else "All local tests passed"
        print(f"{passed}. Evidence: {output}", flush=True)
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        # A failed run on the second Mac already printed its own error and saturation note.
        report.setdefault("error", str(error))
        print(f"error: {error}", file=sys.stderr)
        if "saturation" in report and "remote" not in report:
            print(report["saturation"], file=sys.stderr)
        return 1
    finally:
        if output:
            report["finished_at"] = datetime.now(timezone.utc).isoformat()
            (output / "run.json").write_text(json.dumps(report, indent=2) + "\n")
        held.close()


if __name__ == "__main__":
    sys.exit(main())
