#!/usr/bin/env python3
"""Run all automated tests locally and retain evidence for the tested checkout."""

import argparse
import calendar
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import plistlib
import re
import shutil
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True
from _my_mac_lock import my_mac_lock

ROOT = Path(__file__).resolve().parents[1]
DESTINATION = "platform=macOS,name=My Mac"
RETAINED_RUNS = 5
EVIDENCE_NAME = re.compile(r"\d{8}-\d{6}-\w+")
TEST_ENVIRONMENT = {key: value for key, value in os.environ.items() if key != "SDKROOT"}
HOST_PID = re.compile(rb" - PodHaven \((\d+)\)'")
QUIET_LOG_SECONDS = 120
SAMPLE_GAP_SECONDS = 60
SAMPLE_SECONDS = 10
SAMPLE_TIMEOUT_SECONDS = 120
POLL_SECONDS = 1
TEST_HOST = "com.artisanalsoftware.PodHaven.debug"
# The system, not the tests, keeps these in the test host's temporary directory.
TEST_HOST_SYSTEM_ENTRIES = {"TemporaryItems", f"{TEST_HOST}.savedState"}
# Xcode names the directory where each run's test host writes coverage profiles with
# ProcessInfo.globallyUniqueString, which holds the pid of the process that made it.
COVERAGE_DIRECTORY = re.compile(r"[0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12}-(\d+)-[0-9A-F]{16}")


def capture(*command):
    return subprocess.check_output(command, cwd=ROOT, env=TEST_ENVIRONMENT,
                                   text=True, stderr=subprocess.STDOUT).strip()


def checkout_state():
    revision = capture("git", "rev-parse", "HEAD")
    digest = hashlib.sha256()
    files = subprocess.check_output(
        ["git", "ls-files", "-v", "--cached", "--others", "--exclude-standard", "-z"],
        cwd=ROOT, env=TEST_ENVIRONMENT)
    entries = {part for part in files.split(b"\0") if part}
    unchecked_paths = sorted(os.fsdecode(entry[2:]) for entry in entries
                             if entry[:1] == b"S" or entry[:1].islower())
    for name in sorted({entry[2:] for entry in entries}):
        path = ROOT / os.fsdecode(name)
        if not path.is_file() and not path.is_symlink():
            continue
        contents = os.fsencode(os.readlink(path)) if path.is_symlink() else path.read_bytes()
        mode = str(path.lstat().st_mode).encode()
        digest.update(name + b"\0" + mode + b"\0" + hashlib.sha256(contents).digest())
    return {"revision": revision, "worktree_sha256": digest.hexdigest(), "unchecked_paths": unchecked_paths,
            "status": capture("git", "status", "--porcelain=v1", "--untracked-files=all")}


def host_alive(pid):
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def sample_stalled_host(process, log):
    """Once the log stops growing while the test host it names is alive, sample that host twice."""
    with log.open("rb") as reader:
        recent, host, quiet_since = b"", None, time.monotonic()
        while True:
            try:
                process.wait(timeout=POLL_SECONDS)
                return
            except subprocess.TimeoutExpired:
                pass
            if chunk := reader.read():
                quiet_since = time.monotonic()
                recent += chunk
                hosts = HOST_PID.findall(recent)
                host = int(hosts[-1]) if hosts else host
                recent = recent[-64:]
            elif host and time.monotonic() - quiet_since >= QUIET_LOG_SECONDS and host_alive(host):
                break
    print(f"{log} has not grown for {QUIET_LOG_SECONDS} seconds while test host {host} runs; sampling it",
          file=sys.stderr, flush=True)
    for index in (1, 2):
        path = log.with_name(f"{log.stem}-host-{host}-{index}.sample.txt")
        try:
            result = subprocess.run(["sample", str(host), str(SAMPLE_SECONDS), "-mayDie", "-file", str(path)],
                                    env=TEST_ENVIRONMENT, capture_output=True, text=True,
                                    timeout=SAMPLE_TIMEOUT_SECONDS)
            failure = (f"exit code {result.returncode}: {result.stdout}{result.stderr}".strip()
                       if result.returncode else "")
        except (OSError, subprocess.SubprocessError) as error:
            failure = str(error)
        if failure or not path.is_file():
            print(f"Could not sample test host {host}: {failure or 'sample wrote no report'}",
                  file=sys.stderr, flush=True)
        else:
            print(f"Sampled test host {host}: {path}", file=sys.stderr, flush=True)
        if index == 1:
            try:
                process.wait(timeout=SAMPLE_GAP_SECONDS)
                return
            except subprocess.TimeoutExpired:
                pass


def run(command, output, name, *, check=True, require_unittest=False, pass_fds=(), watch_host=False):
    log = output / f"{name}.log"
    print(f"Running {name}; log: {log}", flush=True)
    with log.open("w") as stream, subprocess.Popen(command, cwd=ROOT, env=TEST_ENVIRONMENT, stdout=stream,
                                                   stderr=subprocess.STDOUT, pass_fds=pass_fds) as process:
        if watch_host:
            sample_stalled_host(process, log)
        returncode = process.wait()
    if returncode:
        print("\n".join(log.read_text(errors="replace").splitlines()[-35:]), file=sys.stderr)
        if check:
            raise RuntimeError(f"{name} failed with exit code {returncode}; see {log}")
    if require_unittest:
        contents = log.read_text(errors="replace")
        counts = re.findall(r"^Ran (\d+) tests? in ", contents, re.M)
        if not counts or int(counts[-1]) == 0 or re.search(r"\bskipped=[1-9]\d*", contents):
            raise RuntimeError(f"{name} has skipped or missing tests; see {log}")
    return returncode


def test_host_data():
    for metadata in (Path.home() / "Library/Containers").glob("*/.com.apple.containermanagerd.metadata.plist"):
        try:
            with metadata.open("rb") as stream:
                identity = plistlib.load(stream)
        except (OSError, ValueError):
            continue
        if isinstance(identity, dict) and identity.get("MCMMetadataIdentifier") == TEST_HOST:
            return metadata.parent / "Data"
    return None


def test_host_temporary_entries(data):
    return set(os.listdir(data / "tmp")) if data and (data / "tmp").is_dir() else set()


def remove_finished_coverage_directories(data):
    """Remove each coverage directory in the test host's container once the process that made it ends."""
    if data is None or not data.is_dir():
        return
    directories = [(entry, int(match[1])) for entry in os.scandir(data)
                   if (match := COVERAGE_DIRECTORY.fullmatch(entry.name)) and entry.is_dir(follow_symlinks=False)]
    if not directories:
        return
    # List processes after the directories, so every maker that is still alive appears.
    started = {}
    for line in subprocess.check_output(["ps", "-A", "-o", "pid=,lstart="], text=True,
                                        env={**TEST_ENVIRONMENT, "TZ": "UTC0", "LC_ALL": "C"}).splitlines():
        pid, start = line.split(None, 1)
        started[int(pid)] = calendar.timegm(time.strptime(" ".join(start.split()), "%a %b %d %H:%M:%S %Y"))
    for entry, pid in directories:
        # A process that started after the directory reuses the pid of the one that made it.
        if pid not in started or started[pid] > entry.stat(follow_symlinks=False).st_birthtime:
            shutil.rmtree(entry.path)


def evidence_files(output):
    return {str(path.relative_to(output)): hashlib.sha256(path.read_bytes()).hexdigest()
            for path in sorted(output.rglob("*")) if path.is_file() and path != output / "run.json"}


def prune_evidence(cache, current):
    earlier = sorted((path for path in cache.iterdir()
                      if path != current and EVIDENCE_NAME.fullmatch(path.name)
                      and not path.is_symlink() and path.is_dir()),
                     key=lambda path: path.stat().st_mtime_ns, reverse=True)
    for path in earlier[RETAINED_RUNS - 1:]:
        shutil.rmtree(path)


def reusable_evidence(report):
    cache = ROOT / ".cache/test-all"
    try:
        output = max((path for path in cache.glob("*") if path.is_dir()),
                     key=lambda path: path.stat().st_mtime_ns, default=None)
        if output is None:
            return None
        saved = json.loads((output / "run.json").read_text())
        if (saved.get("schema") != 1 or saved.get("result") != "passed"
                or not saved.get("finished_at")
                or any(saved.get(key) != report[key]
                       for key in ("checkout", "destination", "xcode", "swift", "macos"))
                or saved.get("checkout_after") != report["checkout"]):
            return None
        artifacts = saved.get("artifacts")
        if (not isinstance(artifacts, dict)
                or not {"tooling.log", "macros.log", "xcodebuild.log", "swift-validation.log",
                        "siri-performance.log", "siri-performance-validation.log"} <= artifacts.keys()
                or not (output / "TestResults.xcresult").is_dir()
                or not (output / "SiriPerformance.xcresult").is_dir()
                or evidence_files(output) != artifacts
                or checkout_state() != report["checkout"]):
            return None
        return output
    except (OSError, ValueError, AttributeError):
        return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--ensure", action="store_true", help="Require clean full evidence; run tests if reuse is unavailable.")
    mode.add_argument("--verify", action="store_true", help="Verify existing clean full evidence without running tests.")
    mode.add_argument("--preflight", action="store_true", help="Check the toolchain without running tests.")
    parser.add_argument("--revision", help="Require this exact commit for --ensure or --verify.")
    args = parser.parse_args()
    if args.revision and not (args.ensure or args.verify):
        parser.error("--revision requires --ensure or --verify")
    output = None
    report = {"schema": 1, "result": "failed", "started_at": datetime.now(timezone.utc).isoformat(),
              "destination": DESTINATION}
    try:
        if Path(capture("git", "rev-parse", "--show-toplevel")).resolve() != ROOT:
            raise RuntimeError("Git must use this checkout; clear inherited Git repository selectors")
        report["xcode"] = capture("xcodebuild", "-hideShellScriptEnvironment", "-version")
        report["swift"] = capture("xcrun", "swift", "--version")
        report["macos"] = capture("sw_vers", "-productVersion")
        xcode = re.search(r"Xcode (\d+)", report["xcode"])
        swift = re.search(r"Swift version (\d+)\.(\d+)", report["swift"])
        if int(report["macos"].split(".")[0]) < 27:
            raise RuntimeError(f"My Mac tests require macOS 27+; detected {report['macos']}. Use a supported Mac.")
        if not xcode or int(xcode[1]) < 27 or not swift or tuple(map(int, swift.groups())) < (6, 4):
            raise RuntimeError(f"Xcode 27+ and Swift 6.4+ are required; select Xcode with DEVELOPER_DIR.\n"
                               f"{report['xcode']}\n{report['swift']}")
        if args.preflight:
            return 0
        report["checkout"] = checkout_state()
        if args.ensure or args.verify:
            if report["checkout"]["unchecked_paths"]:
                raise RuntimeError("Release validation requires clearing Git assume-unchanged and skip-worktree flags: "
                                   + ", ".join(report["checkout"]["unchecked_paths"]))
            if report["checkout"]["status"]:
                raise RuntimeError("Release validation requires a fully clean working tree. Commit your changes first.")
            if args.revision and report["checkout"]["revision"] != args.revision:
                raise RuntimeError("Checkout revision changed; restart the release from the intended commit")
            evidence = reusable_evidence(report)
            if evidence:
                print(f"Verified full local test evidence: {evidence}", flush=True)
                return 0
            if args.verify:
                raise RuntimeError("No valid full local test evidence for this clean revision and toolchain; run bin/test-all")
        cache = ROOT / ".cache/test-all"
        cache.mkdir(parents=True, exist_ok=True)
        output = Path(tempfile.mkdtemp(prefix=datetime.now().strftime("%Y%m%d-%H%M%S-"), dir=cache))
        print(f"Test evidence: {output}", flush=True)
        prune_evidence(cache, output)

        run([str(ROOT / "bin/check"), "--full", "--no-reuse"], output, "tooling", require_unittest=True)
        files = subprocess.check_output(
            ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", ".agents"],
            cwd=ROOT, env=TEST_ENVIRONMENT)
        tests = sorted({Path(os.fsdecode(name)) for name in files.split(b"\0") if name})
        for path in tests:
            if (ROOT / path).is_file() and path.match("test_*.py"):
                run([sys.executable, "-B", str(path), "--verbose"], output,
                    str(path).replace("/", "_"), require_unittest=True)

        run([str(ROOT / "bin/lint-swift-format")], output, "swift-lint")
        run(["xcrun", "swift", "test", "--package-path", "PodHavenMacros"], output, "macros")
        macro_log = (output / "macros.log").read_text(errors="replace")
        if re.search(r"(?:^|\s)warning:", macro_log, re.I):
            raise RuntimeError(f"Macro tests emitted warnings; see {output / 'macros.log'}")
        if not re.search(r"Executed [1-9]\d* tests?", macro_log):
            raise RuntimeError(f"No executed macro tests found; see {output / 'macros.log'}")
        if re.search(r"\b[1-9]\d* (?:tests? )?skipped\b", macro_log, re.I):
            raise RuntimeError(f"Macro tests were skipped; see {output / 'macros.log'}")

        with my_mac_lock(f"bin/test-all in {ROOT}") as lock:
            earlier_entries = test_host_temporary_entries(test_host_data())
            try:
                for bundle_name, log_name, validation_name, selection, validation_options in (
                    ("TestResults", "xcodebuild", "swift-validation",
                     "-skip-testing:PodHavenTests/SiriLargeCatalogTests", ["--full"]),
                    ("SiriPerformance", "siri-performance", "siri-performance-validation",
                     "-only-testing:PodHavenTests/SiriLargeCatalogTests", []),
                ):
                    bundle = output / f"{bundle_name}.xcresult"
                    test_status = run([
                        "xcodebuild", "test", "-hideShellScriptEnvironment", "-project", "PodHaven.xcodeproj",
                        "-scheme", "PodHaven", "-testPlan", "PodHaven", "-destination", DESTINATION,
                        "-skipMacroValidation", "-resultBundlePath", str(bundle), selection,
                        "LM_FORCE_LINK_GENERATION=YES",
                    ], output, log_name, check=False, pass_fds=(lock,), watch_host=True)
                    samples = "".join(f"\nTest host sample: {path}"
                                      for path in sorted(output.glob(f"{log_name}-host-*.sample.txt")))
                    if not bundle.is_dir():
                        raise RuntimeError(f"Swift tests did not produce a result bundle (exit code {test_status}); "
                                           f"see {output / (log_name + '.log')} for the launch or build failure{samples}")
                    validation_status = run([
                        str(ROOT / "bin/check-swift-results"), str(bundle),
                        "--build-log", str(output / f"{log_name}.log"), *validation_options,
                    ], output, validation_name, check=False)
                    if test_status or validation_status:
                        raise RuntimeError(f"Swift tests or evidence validation failed ({log_name}){samples}")
            finally:
                remove_finished_coverage_directories(test_host_data())
            data = test_host_data()
            if data is None:
                raise RuntimeError(f"Could not find the {TEST_HOST} container that ran the tests")
            left = sorted(test_host_temporary_entries(data) - earlier_entries - TEST_HOST_SYSTEM_ENTRIES)
            if left:
                raise RuntimeError(f"Tests left {len(left)} new entries in {data / 'tmp'}: {', '.join(left[:10])}"
                                   "; put test files under TestFiles.uniqueURL()")
        report["checkout_after"] = checkout_state()
        if any(report["checkout_after"][key] != report["checkout"][key]
               for key in ("revision", "worktree_sha256")):
            raise RuntimeError("Checkout changed during testing; rerun bin/test-all for the final changes")
        if args.ensure and (report["checkout_after"]["status"] or report["checkout_after"]["unchecked_paths"]):
            raise RuntimeError("Checkout is no longer clean; resolve changes and rerun bin/test-all")
        report["artifacts"] = evidence_files(output)
        report["result"] = "passed"
        print(f"All local tests passed. Evidence: {output}", flush=True)
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        report["error"] = str(error)
        print(f"error: {error}", file=sys.stderr)
        return 1
    finally:
        if output:
            report["finished_at"] = datetime.now(timezone.utc).isoformat()
            (output / "run.json").write_text(json.dumps(report, indent=2) + "\n")


if __name__ == "__main__":
    sys.exit(main())
