#!/bin/bash
# Prepares a worktree for Xcode by sharing SourcePackages and enabling compilation caching.
# Usage: prep-worktree <worktree-path>

set -eo pipefail

if [ -z "$1" ]; then
  echo "Usage: prep-worktree <worktree-path>"
  exit 1
fi

WORKTREE_PATH="$(cd "$1" && pwd)"
COMMON_GIT_DIR="$(git -C "$WORKTREE_PATH" rev-parse --path-format=absolute --git-common-dir)"
MAIN_REPO="$(cd "$COMMON_GIT_DIR/.." && pwd)"
DERIVED_DATA_DIR="$HOME/Library/Developer/Xcode/DerivedData"
PROJECT_NAME="PodHaven"
# Stable SwiftPM clone path, deliberately outside DerivedData so cache cleaners
# that target DerivedData can't destroy it.
SHARED_SPM="$HOME/Library/Developer/SharedSourcePackages/$PROJECT_NAME"

allow_direnv_envrc() {
  if ! command -v direnv >/dev/null 2>&1 || [ ! -f "$WORKTREE_PATH/.envrc" ]; then
    return
  fi

  if [ -f "$MAIN_REPO/.envrc" ] && cmp -s "$MAIN_REPO/.envrc" "$WORKTREE_PATH/.envrc"; then
    if direnv allow "$WORKTREE_PATH/.envrc"; then
      echo "Allowed .envrc for direnv"
    else
      echo "Warning: direnv allow failed for $WORKTREE_PATH/.envrc"
    fi
    return
  fi

  echo "Warning: .envrc differs from main repo; review it before running direnv allow"
}

xcode_hash() {
  python3 -c "
import hashlib, struct, sys
md5 = hashlib.md5(sys.argv[1].encode('utf-8')).digest()
hi, lo = struct.unpack('>QQ', md5)
r = [''] * 28
v = hi
for i in range(13, -1, -1):
    r[i] = chr(ord('a') + v % 26); v //= 26
v = lo
for i in range(27, 13, -1):
    r[i] = chr(ord('a') + v % 26); v //= 26
print(''.join(r))
" "$1"
}

# Delete DerivedData left behind by removed worktrees. Xcode records the project
# it built from in each folder's info.plist; if that path is gone, so is the
# worktree. Git has no worktree-removal hook, so this garbage-collects on the
# next worktree creation regardless of how the old one was removed.
prune_orphan_derived_data() {
  [ -d "$DERIVED_DATA_DIR" ] || return
  for dd in "$DERIVED_DATA_DIR/$PROJECT_NAME"-*; do
    [ -d "$dd" ] || continue
    [ -f "$dd/info.plist" ] || continue
    local ws
    ws="$(plutil -extract WorkspacePath raw "$dd/info.plist" 2>/dev/null || true)"
    if [ -n "$ws" ] && [ ! -e "$ws" ]; then
      echo "Pruning orphaned DerivedData: $(basename "$dd")"
      rm -rf "$dd"
    fi
  done
}

allow_direnv_envrc
prune_orphan_derived_data

MAIN_HASH=$(xcode_hash "$MAIN_REPO/$PROJECT_NAME.xcodeproj")
MAIN_DD="$DERIVED_DATA_DIR/$PROJECT_NAME-$MAIN_HASH"

WT_HASH=$(xcode_hash "$WORKTREE_PATH/$PROJECT_NAME.xcodeproj")
WT_DD="$DERIVED_DATA_DIR/$PROJECT_NAME-$WT_HASH"

# Share SwiftPM checkouts via one clone at SHARED_SPM. xcodebuild is pointed
# straight at it below; Xcode's IDE only reads <DerivedData>/SourcePackages, so
# we also symlink that to SHARED_SPM. A DerivedData wipe then only removes the
# symlinks, never the checkouts.
mkdir -p "$(dirname "$SHARED_SPM")"
if [ ! -e "$SHARED_SPM" ]; then
  if [ -d "$MAIN_DD/SourcePackages" ] && [ ! -L "$MAIN_DD/SourcePackages" ]; then
    mv "$MAIN_DD/SourcePackages" "$SHARED_SPM"
    ln -s "$SHARED_SPM" "$MAIN_DD/SourcePackages"
    echo "Seeded shared SourcePackages from main repo"
  elif [ -d "$WT_DD/SourcePackages" ] && [ ! -L "$WT_DD/SourcePackages" ]; then
    mv "$WT_DD/SourcePackages" "$SHARED_SPM"
    echo "Seeded shared SourcePackages from this worktree"
  else
    mkdir -p "$SHARED_SPM"
    echo "Created shared SourcePackages (background build will populate it)"
  fi
fi

# Point main's DerivedData at the shared path too, so the IDE on main shares it.
if [ -d "$SHARED_SPM/checkouts" ] && [ -d "$MAIN_DD/SourcePackages" ] && [ ! -L "$MAIN_DD/SourcePackages" ]; then
  rm -rf "$MAIN_DD/SourcePackages"
  ln -s "$SHARED_SPM" "$MAIN_DD/SourcePackages"
  echo "Relinked main repo SourcePackages to shared clone path"
fi

# Point this worktree's DerivedData at the shared path.
mkdir -p "$WT_DD"
if [ -L "$WT_DD/SourcePackages" ] && [ "$(readlink "$WT_DD/SourcePackages")" = "$SHARED_SPM" ]; then
  echo "SourcePackages already linked to shared clone path"
else
  rm -rf "$WT_DD/SourcePackages"
  ln -s "$SHARED_SPM" "$WT_DD/SourcePackages"
  echo "Linked SourcePackages to shared clone path"
fi

# Symlink qmd model cache (~2GB of immutable HF GGUFs) from main repo
MAIN_QMD_MODELS="$MAIN_REPO/.cache/qmd/models"
WT_QMD_MODELS="$WORKTREE_PATH/.cache/qmd/models"
if [ -d "$MAIN_QMD_MODELS" ] && [ ! -e "$WT_QMD_MODELS" ]; then
  mkdir -p "$(dirname "$WT_QMD_MODELS")"
  ln -s "$MAIN_QMD_MODELS" "$WT_QMD_MODELS"
  echo "Linked qmd models"
elif [ -L "$WT_QMD_MODELS" ]; then
  echo "qmd models already linked"
elif [ ! -d "$MAIN_QMD_MODELS" ]; then
  echo "Warning: main repo qmd models not found — first qmd run will download ~2GB"
fi

# Copy compilation caching settings
SETTINGS_SRC="$MAIN_REPO/$PROJECT_NAME.xcodeproj/project.xcworkspace/xcuserdata/$(whoami).xcuserdatad/WorkspaceSettings.xcsettings"
SETTINGS_DST="$WORKTREE_PATH/$PROJECT_NAME.xcodeproj/project.xcworkspace/xcuserdata/$(whoami).xcuserdatad/WorkspaceSettings.xcsettings"
if [ -f "$SETTINGS_SRC" ] && [ ! -f "$SETTINGS_DST" ]; then
  mkdir -p "$(dirname "$SETTINGS_DST")"
  cp "$SETTINGS_SRC" "$SETTINGS_DST"
  echo "Copied workspace settings (compilation caching)"
fi

# Kick off a background build to warm the cache
BUILD_LOG="/tmp/prep-worktree-build-$(basename "$WORKTREE_PATH").log"
if [ ! -f "$WT_DD/Build/Products" ] || [ "$(find "$WT_DD/Build" -name '*.o' 2>/dev/null | head -1)" = "" ]; then
  echo "Starting background build to warm cache..."
  cd "$WORKTREE_PATH" && xcodebuild build \
    -project "$PROJECT_NAME.xcodeproj" \
    -scheme "$PROJECT_NAME" \
    -destination 'platform=iOS Simulator,name=iPhone 17 Pro' \
    -clonedSourcePackagesDirPath "$SHARED_SPM" \
    -quiet \
    > "$BUILD_LOG" 2>&1 </dev/null &
  disown 2>/dev/null || true
  echo "Build running in background (log: $BUILD_LOG)"
else
  echo "Build artifacts already exist, skipping background build"
fi

echo "Ready: open $WORKTREE_PATH/$PROJECT_NAME.xcodeproj"
