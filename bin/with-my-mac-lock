#!/usr/bin/env python3
"""usage: bin/with-my-mac-lock COMMAND [ARG...]

Run a command, such as a focused My Mac xcodebuild test, while holding the machine-wide lock that
bin/test-all also takes. A busy lock prints its holder and waits. The command keeps the lock until it
and every process that inherited the lock exit; nested calls reuse it."""

import os
import shlex
import sys

sys.dont_write_bytecode = True
from _my_mac_lock import INHERITED_FD, my_mac_lock

command = sys.argv[1:]
if not command or command[0] in ("-h", "--help"):
    print(__doc__, file=sys.stdout if command else sys.stderr)
    sys.exit(0 if command else 2)
with my_mac_lock(f"{shlex.join(command)} in {os.getcwd()}") as descriptor:
    os.set_inheritable(descriptor, True)
    os.environ[INHERITED_FD] = str(descriptor)
    try:
        os.execvp(command[0], command)
    except OSError as error:
        print(f"with-my-mac-lock: {command[0]}: {error.strerror}", file=sys.stderr)
        sys.exit(127)
