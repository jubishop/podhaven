#!/usr/bin/env python3
"""Read or set PodHaven's app version across all Xcode configurations."""

from pathlib import Path
import re
import subprocess
import sys


def version_parts(value):
    if not re.fullmatch(r"(?:0|[1-9][0-9]*)(?:\.(?:0|[1-9][0-9]*)){0,2}", value):
        raise ValueError("Use one to three numbers separated by dots, such as 1.0.1.")
    parts = tuple(int(part) for part in value.split("."))
    return parts + (0,) * (3 - len(parts))


def main():
    if sys.argv[1:] in (["--help"], ["-h"]):
        print("Usage: bin/version [new-version]\nWithout an argument, print the current app version.\n"
              "Setting a version requires a fully clean working tree. It commits only the version change\n"
              "and pushes the current branch to its configured upstream. Repeat to retry a failed push.")
        return 0
    try:
        if len(sys.argv) > 2:
            raise ValueError("Usage: bin/version [new-version]")
        project = Path(__file__).resolve().parents[1] / "PodHaven.xcodeproj/project.pbxproj"
        source = project.read_text()
        setting = re.compile(r"(?m)^([ \t]*MARKETING_VERSION[ \t]*=[ \t]*)([^;\r\n]+)(;)")
        versions = {match[2].strip().strip('"') for match in setting.finditer(source)}
        if len(versions) != 1:
            raise ValueError("Expected one consistent MARKETING_VERSION across all Xcode configurations.")
        current = versions.pop()
        current_parts = version_parts(current)
        if len(sys.argv) == 1:
            print(current)
            return 0
        new_version = sys.argv[1]
        if version_parts(new_version) < current_parts:
            raise ValueError(f"The new app version must not be older than {current}.")
        root = project.parents[1]
        git = ["git", "-C", str(root)]
        if subprocess.check_output([*git, "status", "--porcelain"], text=True).strip():
            raise ValueError("Setting a version requires a fully clean working tree. Commit your changes first.")
        branch = subprocess.check_output([*git, "branch", "--show-current"], text=True).strip()
        if not branch:
            raise ValueError("Check out a branch with a configured upstream before changing the version.")
        remote = subprocess.check_output([*git, "config", "--get", f"branch.{branch}.remote"], text=True).strip()
        destination = subprocess.check_output([*git, "config", "--get", f"branch.{branch}.merge"], text=True).strip()
        if not remote or not destination.startswith("refs/heads/"):
            raise ValueError("Configure the current branch's upstream before changing the version.")
        pending_push = Path(subprocess.check_output(
            [*git, "rev-parse", "--path-format=absolute", "--git-path", "podhaven-version-push"], text=True).strip())
        if pending_push.exists() and pending_push.read_text().strip() != branch:
            raise ValueError("A version push is unfinished on another branch. Retry bin/version there first.")
        if new_version != current:
            project.write_text(setting.sub(lambda match: match[1] + new_version + match[3], source))
            relative = str(project.relative_to(root))
            subprocess.run([*git, "add", "--", relative], check=True)
            subprocess.run([*git, "commit", "-m", f"Change version number to {new_version}", "--", relative], check=True)
        pending_push.write_text(branch + "\n")
        subprocess.run([*git, "push", "--", remote, f"HEAD:{destination}"], check=True)
        pending_push.unlink()
        print(new_version)
        return 0
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"error: {error}", file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError) and "push" in error.cmd:
            print(f"The version commit is local. Retry bin/version {sys.argv[1]} to push it.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
