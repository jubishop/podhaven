#!/usr/bin/env python3
"""Write TestFlight or App Store notes for app changes since a build, or report changes testers lack."""

import argparse
from datetime import datetime
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile


APP_PATHS = ("PodHaven", "PodHavenShare", "PodHavenWidget", "PodHavenIntents", "PodHavenMacros")
EXCLUSIONS = ("Leave out code names, file and type names, issue or pull request numbers, and purely internal work "
              "such as logging, diagnostics, telemetry, tests, and refactors.")
AUDIENCES = {
    "testflight": ("TestFlight", (
        'You write TestFlight "What to Test" notes for PodHaven, an iPhone podcast app. The input is the commit '
        "messages for app code changed since the build testers already have. Write one or two short, casual "
        "sentences in plain everyday words that tell testers what changed that they might notice. " + EXCLUSIONS +
        " If nothing would be noticeable, say the build has behind-the-scenes stability improvements. "
        "Reply with only the notes."),
        "Behind-the-scenes stability and performance improvements."),
    "appstore": ("App Store", (
        'You write the App Store "What\'s New" text for PodHaven, an iPhone podcast app. The input is the commit '
        "messages for app code changed since the version listeners already have. Write at most five short "
        'bullets, each on its own line starting with "• ", in plain everyday words that tell listeners what is '
        "new or fixed. Group related changes and lead with the most noticeable. " + EXCLUSIONS +
        " If nothing would be noticeable, write one bullet about stability improvements. "
        "Reply with only the bullets."),
        "• Behind-the-scenes stability and performance improvements."),
}
MAX_BYTES = 4000
SUMMARY_THRESHOLD = 3
UNTESTED_PROMPT = (
    "You brief PodHaven's developer on app changes that TestFlight testers have not received yet, before an App "
    "Store release. The input is the full commit messages. Write at most six technical bullets, each one line "
    'of at most 25 words starting with "- ", with no nested lists or Markdown emphasis. Group related commits, '
    "name the affected subsystems, and put the riskiest changes first. Reply with only the bullets.")
TRAILER = re.compile(r"[A-Za-z-]+-by: ", re.IGNORECASE)


def git(root, *args):
    return subprocess.check_output(["git", "-C", str(root), *args], text=True)


def ask_llm(prompt, text):
    result = subprocess.run(["llm", "-s", prompt], input=text, text=True, capture_output=True)
    if result.returncode != 0:
        print(result.stderr, end="", file=sys.stderr)
        return ""
    return result.stdout.strip()


def day(moment):
    return f"{moment:%b} {moment.day}, {moment.year}"


def count(number, noun):
    return f"{number} {noun}{'' if number == 1 else 's'}"


def moment(stamp):
    return datetime.fromtimestamp(int(stamp)).astimezone()


def report_untested(root, base, end):
    commits = []
    for entry in git(root, "log", "--reverse", "--format=%h%x1f%at%x1f%B%x1e", f"{base}..{end}", "--", *APP_PATHS).split("\x1e"):
        if entry.strip():
            short, stamp, message = entry.strip().split("\x1f", 2)
            commits.append((short, moment(stamp), message.strip()))
    if not commits:
        return
    landed = [moment(stamp) for stamp in git(root, "log", "--format=%at", f"{base}..{end}").split()]
    shipped = moment(git(root, "for-each-ref", "--format=%(creatordate:unix)", f"refs/tags/{base}").strip())
    age = (datetime.now().astimezone().date() - shipped.date()).days
    ago = "today" if age == 0 else "yesterday" if age == 1 else f"{age} days ago"
    first, last = min(landed), max(landed)
    span = f"on {day(first)}" if first.date() == last.date() else f"between {day(first)} and {day(last)}"
    lines = [f"==> Testers in Everyone don't have {count(len(commits), 'app commit')} yet.", "",
             f"Their newest build, {base}, went out {day(shipped)} at {shipped.hour % 12 or 12}:{shipped:%M %p %Z} ({ago}).",
             f"Since then, {count(len(landed), 'commit')} landed {span}, and {len(commits)} of them "
             f"change{'s' if len(commits) == 1 else ''} the app.", ""]

    summary = ""
    if len(commits) > SUMMARY_THRESHOLD:
        summary = ask_llm(UNTESTED_PROMPT, "\n\x1e".join(message for _, _, message in commits))
    if summary:
        lines += ["Summary:", summary, "", "Commits:"]
        lines += [f"  {day(when)}  {short}  {message.splitlines()[0]}" for short, when, message in commits]
        lines.append("")
    else:
        for short, when, message in commits:
            subject, _, body = message.partition("\n")
            lines.append(f"{day(when)}  {short}  {subject}")
            lines += [f"    {line}".rstrip() for line in body.strip().splitlines() if not TRAILER.match(line)]
            lines.append("")
    print("\n".join(lines), file=sys.stderr, flush=True)

    stop = "Stopped before releasing app changes testers don't have. Run testflight first"
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        sys.exit(stop + ", or run appstore in a terminal and answer y.")
    print("Release to the App Store anyway? [y/N] ", end="", file=sys.stderr, flush=True)
    if sys.stdin.readline().strip().lower() not in ("y", "yes"):
        sys.exit(stop + ".")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("audience", choices=(*AUDIENCES, "untested"))
    parser.add_argument("--since-build", required=True, metavar="NUMBER",
                        help="Build number whose release tag starts the summarized changes.")
    parser.add_argument("--to", default="HEAD", metavar="REF", help="Revision that ends the summarized changes.")
    args = parser.parse_args()
    if not re.fullmatch(r"[0-9]+", args.since_build):
        parser.error("--since-build requires a numeric build number, such as 581.")
    root = Path(__file__).resolve().parents[1]
    remedy = " Pass --notes." if args.audience in AUDIENCES else ""

    pattern = re.compile(r"v[0-9]+(?:\.[0-9]+){0,2}b" + args.since_build)
    tags = [tag for tag in git(root, "tag", "-l", "v*b" + args.since_build).split() if pattern.fullmatch(tag)]
    if len(tags) != 1:
        sys.exit(f"error: Expected one local release tag for build {args.since_build}, found {len(tags)}. "
                 f"Fetch tags with git fetch --tags.{remedy}")
    base = tags[0]
    if subprocess.run(["git", "-C", str(root), "merge-base", "--is-ancestor", base, args.to]).returncode != 0:
        sys.exit(f"error: {base} is not an ancestor of {args.to}.{remedy}")
    if args.audience == "untested":
        report_untested(root, base, args.to)
        return

    label, prompt, fallback = AUDIENCES[args.audience]

    log = git(root, "log", "--format=%B%x1e", f"{base}..{args.to}", "--", *APP_PATHS).strip()
    if log:
        notes = ask_llm(prompt, log)
        if not notes:
            sys.exit(f"error: llm could not write {label} notes. Pass --notes.")
    else:
        notes = fallback
    if not notes or len(notes.encode()) > MAX_BYTES:
        sys.exit(f"error: Generated {label} notes must contain 1 to {MAX_BYTES} bytes. Pass --notes.")

    print(f"==> {label} notes for changes since {base}:\n\n{notes}\n", file=sys.stderr, flush=True)
    while sys.stdin.isatty() and sys.stderr.isatty():
        print("Use these notes? [Y/e/n] ", end="", file=sys.stderr, flush=True)
        answer = sys.stdin.readline()
        choice = answer.strip().lower()
        if answer and choice in ("", "y", "yes"):
            if len(notes.encode()) <= MAX_BYTES:
                break
            print(f"Notes must be at most {MAX_BYTES} bytes; edit them or stop.", file=sys.stderr)
        elif answer and choice in ("e", "edit"):
            with tempfile.TemporaryDirectory(prefix="podhaven-notes-") as directory:
                path = Path(directory) / "notes.txt"
                path.write_text(notes + "\n")
                editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi")
                if subprocess.run([*editor, str(path)], stdout=sys.stderr).returncode != 0:
                    sys.exit("error: The editor failed. Run again, or pass --notes.")
                notes = path.read_text().strip()
            if not notes:
                sys.exit("Stopped: the edited notes were empty. Run again, or pass --notes.")
            print(f"==> Edited {label} notes:\n\n{notes}\n", file=sys.stderr, flush=True)
        else:
            sys.exit("Stopped without the generated notes. Run again to regenerate them, or pass --notes.")
    print(notes)


if __name__ == "__main__":
    main()
