desc "Assign an uploaded PodHaven build to the external Everyone group"
lane :distribute_testflight do |options|
  require_relative "testflight"
  PodHavenTestFlight.run(options)
end

desc "Add, remove, or list the testers in the external Everyone group"
lane :manage_testers do
  require_relative "testflight"
  PodHavenTestFlight.manage_testers
end

desc "Show App Store status or submit an uploaded PodHaven build"
lane :manage_appstore do |options|
  require_relative "appstore"
  PodHavenAppStore.run(options)
end
